NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=Colportando
SQL_USER=colportando_app
SQL_PASSWORD=replace-me
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_POOL_MAX=10
SQL_POOL_MIN=0
SQL_POOL_IDLE_TIMEOUT_MS=30000
JWT_ISSUER=colportando-backend
JWT_AUDIENCE=colportando-clients
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
ACTION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=7776000
AUTH_ACTION_TOKEN_TTL_SECONDS=3600
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_ACTION_BASE_URL=http://localhost:5173/auth
MAIL_ADAPTER=disabled
MAIL_FROM_NAME=Colportando App
AUTH_EMAIL=
AUTH_PASS=
AUTH_PASS_APP=
