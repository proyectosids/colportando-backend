{
  "name": "colportando-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend SaaS para la gestión de clubes de colportores",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "vitest run tests/integration",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "migrate": "tsx src/shared/infrastructure/database/migrate.ts",
    "database:verify-foundation": "tsx scripts/verify-foundation-database.ts",
    "database:verify-auth": "tsx scripts/verify-auth-database.ts",
    "database:verify-invitations": "tsx scripts/verify-invitation-database.ts",
    "database:verify-training": "tsx scripts/verify-training-database.ts",
    "database:verify-member-transitions": "tsx scripts/verify-member-transitions-database.ts",
    "database:verify-campaign-operations": "tsx scripts/verify-campaign-operations-database.ts",
    "mail:verify": "tsx scripts/verify-mail-connection.ts",
    "mail:preview": "tsx scripts/preview-auth-emails.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mssql": "^12.7.14",
    "nodemailer": "^10.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
